{
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ws/*",
      "/health",
      "/downloads/*"
    ],
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Relay"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "preview_urls": false
}
